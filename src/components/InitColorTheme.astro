<script is:inline>
  (() => {
    let storedSetting = ''

    try {
      storedSetting = localStorage.getItem('theme') || ''
    } catch (e) {}

    const isDarkPreferred = window.matchMedia('(prefers-color-scheme: dark)').matches  
    const theme = ['dark', 'light'].includes(storedSetting)
      ? storedSetting
      : isDarkPreferred
        ? 'dark'
        : 'light'
  
    document.documentElement.classList.toggle('dark', theme === 'dark')
  })()
</script>