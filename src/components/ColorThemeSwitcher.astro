---
---
<button
  id="theme_toggle"
  aria-label="カラーテーマ切り替えボタン"
>
  <div id="theme_toggle_dark" class="i-mynaui-moon-solid"></div>
  <div id="theme_toggle_light" class="i-mynaui-sun-medium-solid hidden"></div>
</button>

<script is:inline>
  (() => {
    const toggler = document.getElementById('theme_toggle')
    if (!toggler) return

    const lightIcon = document.getElementById('theme_toggle_light')
    const darkIcon = document.getElementById('theme_toggle_dark')

    const toggleThemeIcon = (isDark) => {
      if (lightIcon) lightIcon.classList.toggle('hidden', !isDark)
      if (darkIcon) darkIcon.classList.toggle('hidden', isDark)
    }
  
    const element = document.documentElement
    toggleThemeIcon(element.classList.contains('dark'))

    toggler.addEventListener('click', () => {
      const isDark = element.classList.toggle('dark')
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light')
      } catch (e) {}
      toggleThemeIcon(isDark)
    })
  })()
</script>

<style lang="scss">
button {
  @apply text-2xl text-neutral-400/75 hover:text-neutral-900 transition ease-in duration-100;

  :global(html.dark) & {
    @apply text-neutral-400/75 hover:text-neutral-100;
  }
}
</style>